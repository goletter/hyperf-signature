{
    "name": "goletter/hyperf-signature",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "goletter",
            "email": "goletter@outlook.com"
        }
    ],
    "keywords": [
        "php",
        "hyperf",
        "signature",
        "hmac"
    ],
    "description": "System-to-system API signature (HMAC) for hyperf.",
    "autoload": {
        "psr-4": {
            "Goletter\\Signature\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HyperfTest\\Signature\\": "tests"
        }
    },
    "require": {
        "php": ">=8.1",
        "hyperf/contract": "^3.1",
        "hyperf/http-server": "^3.1",
        "psr/http-message": "^1.0|^2.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.0",
        "phpunit/phpunit": "^10.0"
    },
    "suggest": {
        "hyperf/redis": "Required for RedisNonceStore.",
        "guzzlehttp/guzzle": "Required for SignatureGuzzleMiddleware."
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml --colors=always"
    },
    "extra": {
        "hyperf": {
            "config": "Goletter\\Signature\\ConfigProvider"
        }
    }
}
